  "theme_descriptions": {
    "induction": "Entering. The body settles and the room narrows before anything is asked.",
    "acceptance": "Resistance stops being worth its cost, and the yes arrives before the question does.",
    "obedience": "The command has already happened by the time it is heard.",
    "focus": "One point holds and everything outside it goes quiet.",
