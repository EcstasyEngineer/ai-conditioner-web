{
  "//": "Browser tsconfig: engine/ + web/ ONLY. tools/ is deliberately excluded and compiled by tsconfig.tools.json — see DESIGN.md §1.3. The measured hazard is a browser barrel re-exporting a module that imports Node `fs` and calls process.cwd(); with `types: []` here, that fails to compile instead of failing in a user's tab.",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "types": [],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": false,

    "baseUrl": "."
  },
  "include": ["engine", "web"],
  "exclude": [
    "node_modules",
    "dist",
    "tools",
    "tests",
    "eslint-rules",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
